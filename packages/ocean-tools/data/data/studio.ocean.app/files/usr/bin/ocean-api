#!/data/data/studio.ocean.app/files/usr/bin/bash
# OceanStudio - ocean-api
set -euo pipefail

if [[ $# -lt 1 ]]; then
  echo "Usage: ocean-api <endpoint> [json_payload]" >&2
  exit 1
fi

ENDPOINT="$1"
PAYLOAD="${2:-}"

if [[ -n "$PAYLOAD" ]]; then
  curl -s -X POST "http://127.0.0.1:8088/api/$ENDPOINT" -H "Content-Type: application/json" -d "$PAYLOAD"
else
  curl -s "http://127.0.0.1:8088/api/$ENDPOINT"
fi
echo ""
