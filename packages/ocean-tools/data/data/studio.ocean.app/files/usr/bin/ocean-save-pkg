#!/data/data/studio.ocean.app/files/usr/bin/bash
set -euo pipefail

pkg="${1:-}"
if [[ -z "$pkg" ]]; then
    echo "Usage: ocean-save-pkg <package_name> [output_directory]"
    exit 1
fi
out_dir="${2:-$HOME/saved_packages/$pkg}"
mkdir -p "$out_dir"

echo "Resolving and downloading $pkg and its dependencies..."
cd "$out_dir"
apt-get download $(apt-cache depends --recurse --no-recommends --no-suggests --no-conflicts --no-breaks --no-replaces "$pkg" 2>/dev/null | grep "^\w" | sort -u || echo "$pkg") 2>/dev/null || apt-get download "$pkg"

count=$(ls -1 *.deb 2>/dev/null | wc -l)
echo "Saved $count packages into $out_dir"
echo "To install offline later: dpkg -i $out_dir/*.deb"
