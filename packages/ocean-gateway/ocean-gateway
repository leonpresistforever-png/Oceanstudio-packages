#!/system/bin/sh
# Independent Ocean server: built-in Node modules, no npm or router downloads.
set -eu
umask 077
export PREFIX="${PREFIX:-/data/data/studio.ocean.app/files/usr}"
export OCEAN_GATEWAY_DATA="${OCEAN_GATEWAY_DATA:-$PREFIX/var/lib/ocean-gateway}"
export OCEAN_GATEWAY_PORT="${OCEAN_GATEWAY_PORT:-20129}"
export DATA_DIR="$OCEAN_GATEWAY_DATA"
runtime="${OCEAN_GATEWAY_CODE:-$PREFIX/share/ocean-gateway}"
if [ ! -f "$runtime/server.mjs" ] && [ -f "$(dirname "$0")/server.mjs" ]; then runtime="$(dirname "$0")"; fi
server="$runtime/server.mjs"
node="${OCEAN_GATEWAY_NODE:-$PREFIX/bin/node}"
if [ ! -x "$node" ]; then node="$(command -v node || true)"; fi
shell=/system/bin/sh
if [ ! -x "$shell" ]; then shell="$(command -v sh)"; fi

check() {
    [ -n "$node" ] && [ -x "$node" ] || { echo 'Installing Ocean Node.js…'; pkg install -y nodejs ca-certificates; node="$PREFIX/bin/node"; }
    "$node" -e 'if(Number(process.versions.node.split(".")[0])<22)throw Error("Ocean Gateway requires Node.js 22 or newer")'
    for module in server store transport providers oauth registrations prepare-runtime connect; do
        [ -s "$runtime/$module.mjs" ] || { echo "Missing Ocean gateway module: $module" >&2; exit 1; }
    done
    "$node" "$runtime/prepare-runtime.mjs" "$OCEAN_GATEWAY_DATA"
}
alive() {
    [ -f "$OCEAN_GATEWAY_DATA/server.pid" ] || return 1
    gateway_pid="$(cat "$OCEAN_GATEWAY_DATA/server.pid")"
    case "$gateway_pid" in ''|*[!0-9]*) return 1;; esac
    [ -r "/proc/$gateway_pid/cmdline" ] || return 1
    tr '\0' '\n' < "/proc/$gateway_pid/cmdline" | grep -Fxq -- "$server" || return 1
    tr '\0' '\n' < "/proc/$gateway_pid/cmdline" | grep -Fxq -- "--env-file=$OCEAN_GATEWAY_DATA/.env" || return 1
    kill -0 "$gateway_pid" 2>/dev/null
}
start() {
    check
    if ! alive; then
        nohup "$shell" "$0" serve > "$OCEAN_GATEWAY_DATA/server.log" 2>&1 &
        echo "$!" > "$OCEAN_GATEWAY_DATA/server.pid"
    fi
    "$node" "$runtime/connect.mjs" wait
}
case "${1:-help}" in
    install) check; echo 'Independent Ocean Gateway 1.0.0 is installed';;
    serve)
        check
        echo "$$" > "$OCEAN_GATEWAY_DATA/server.pid"
        exec "$node" "--env-file=$OCEAN_GATEWAY_DATA/.env" "$server"
        ;;
    start) start;;
    status) "$node" "$runtime/connect.mjs" status;;
    connect) start; "$node" "$runtime/connect.mjs" connect "${2:-codex}";;
    add-local) start; "$node" "$runtime/connect.mjs" add-local "${2:-http://127.0.0.1:11434/v1}";;
    stop)
        if alive; then kill "$gateway_pid"; fi
        rm -f "$OCEAN_GATEWAY_DATA/server.pid"
        ;;
    *) echo 'ocean-gateway install | start | serve | status | connect codex|antigravity|gemini-cli | add-local [loopback /v1 URL] | stop';;
esac
